{
  // MacBookPro16,1: Intel + AMD is Apple gmux, not ASUS supergfxctl.
  // Omarchy 4.0 key:
  "trigger.hardware.hybrid-gpu": {
    "when": "false",
    "description": "Hidden on this T2 16,1. Do not run omarchy toggle hybrid gpu."
  },
  // Omarchy 4.5 keys (shown whenever two GPUs are present, i.e. always here):
  "trigger.hardware.hybrid-gpu-on": {
    "when": "false",
    "description": "Hidden on this T2 16,1. Do not run omarchy toggle hybrid gpu."
  },
  "trigger.hardware.hybrid-gpu-off": {
    "when": "false",
    "description": "Hidden on this T2 16,1. Do not run omarchy toggle hybrid gpu."
  }
}
