+    /// Move toward `target`. A rise covers at most the full min-to-max range
+    /// per `ramp_up_s` (`dt` seconds since the last step); a fall is applied
+    /// at once. Writes only on change. Returns true while still below target.
+    pub fn step_toward(&self, target: u32, dt: f32) -> Result<bool> {
+        let target = target.clamp(self.min_speed, self.max_speed);
+        let next = match self.applied.get() {
+            Some(cur) if target > cur && self.config.ramp_up_s > 0.0 => {
+                let range = (self.max_speed - self.min_speed) as f32;
+                let step = (range * dt / self.config.ramp_up_s).ceil().max(1.0) as u32;
+                cur.saturating_add(step).min(target)
+            }
+            _ => target,
+        };
+        if self.applied.get() != Some(next) {
+            self.set_speed(next)?;
+            self.applied.set(Some(next));
+        }
+        Ok(next < target)
+    }
+
