  yuters-0001-apple-gmux-switch-panel-mux-before-drm-binds.patch
  yuters-0002-amdgpu-skip-in-kernel-fbdev-on-gmux-hybrid.patch
  yuters-0003-amdgpu-dm-skip-ghost-edp.patch
  yuters-0004-pci-pm-s2idle-bypass-mbp161.patch
  yuters-0005-titan-ridge-type3-power-sequence.patch
)
source_x86_64=(config.x86_64)
