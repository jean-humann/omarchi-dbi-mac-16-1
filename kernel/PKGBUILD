  yuters-0004-pci-pm-s2idle-bypass-mbp161.patch
  yuters-0005-titan-ridge-type3-power-sequence.patch

  # KaiT2en 8de9546 + klizas 5181c93 — applied AFTER yuters, in this order (see PATCHES.md)
  extra-01-kait2en-w0001-brcmfmac-no-txbf.patch
  extra-02-kait2en-w0002-btbcm-acl-priority.patch
  extra-03-kait2en-w0003-brcmfmac-ps-200ms.patch
  extra-04-kait2en-w0014-brcmfmac-arp-nd-offload-off.patch
  extra-05-kait2en-i0001-psr-apple-panels.patch
  extra-06-kait2en-i0002-psr-tcon-handshake.patch
  extra-07-kait2en-i0003-gmux-brightness-restore.patch
  extra-08-klizas-touchbar-suspend-resume.patch
  extra-09-klizas-appletbdrm-zlp-pad.patch
  extra-10-klizas-appletbdrm-kzalloc-request.patch
  extra-11-klizas-appletbdrm-reset-free-old-state.patch
  extra-12-klizas-brcmfmac-suspend-fix.patch
  extra-13-klizas-brcmfmac-resume-liveness-probe.patch
)
