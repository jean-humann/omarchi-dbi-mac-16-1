pkgver=7.2.3.arch1
pkgrel=1
pkgdesc='Linux for T2 Macs + MacBookPro16,1 Intel-primary s2idle/USB-C (yuters e77b03f)'
url='https://github.com/archlinux/linux'
arch=(
  x86_64
)
