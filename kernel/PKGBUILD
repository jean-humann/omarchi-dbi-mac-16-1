# linux-t2-mbp161 — Watanare linux-t2 packaging 7.2.15.arch1-1 plus yuters e77b03f
# Intel-primary patches 0001–0005, then extra-*.patch (KaiT2en, klizas). Does not replace linux-t2.
#
# Upstream packaging: NoaHimesaka1873/linux-t2-arch @ b68c1c2 (v7.2.14.arch1-1), bumped by hand to 7.2.15
# Kernel 7.2.15 is the last 7.2 release (EOL). linux-t2-arch main pins t2linux 777f516 (KVER=7.3).
# t2linux: e167207 (2026-10-16, KVER=7.2.10), the last linux-t2-patches commit before 7.3.
# Patches: yuters/mbp161-hybrid-graphics e77b03fe0902216a7544208f2988b4cd391423a1
#   0001 refreshed for t2linux e167207 (force_idg typo fixed upstream). See PATCHES.md.
# Do not use yuters main (Falcon / panel-on-AMD).

pkgbase=linux-t2-mbp161
